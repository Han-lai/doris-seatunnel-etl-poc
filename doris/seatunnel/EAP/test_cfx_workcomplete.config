env {
  parallelism = 1
  job.mode = "STREAMING" #STREAMING
  checkpoint.interval = 6000
}

source {
  Kafka {
    result_table_name = "kafka_source"   # Add this line to store the raw data
    schema = {
      fields {
        receiveat = String,
        MessageID = String,
        MessageType = String,
        MessageVersion = String,
        MessageTime = String,
        Sender = String,
        Data = String
      }
    }
    format = json
    topic = "Test_cfx_workcomplete"
    bootstrap.servers = "<kafka-broker>:9092"
    kafka.config = {
      max.poll.records = 1000
      auto.offset.reset = "earliest"
      security.protocol = PLAINTEXT
      sasl.mechanism = PLAIN
    }
  }
}

transform {
  JsonPath {
    source_table_name = "kafka_source"
    result_table_name = "trans_json"   # Add this line to store the transformed data
    row_error_handle_way = SKIP  # è·³é??¯èª¤è¡?
    columns = [
      {
        "src_field" = "Data"
        "path" = "$.ProcessedTime"
        "dest_field" = "ProcessedTime"
      },
      {
        "src_field" = "Data"
        "path" = "$.Meta.DeviceID"
        "dest_field" = "Meta_DeviceID"
      },
      {
        "src_field" = "Data"
        "path" = "$.Meta.LineID"
        "dest_field" = "Meta_LineID"
      },
      {
        "src_field" = "Data"
        "path" = "$.Meta.MfgPlantCode"
        "dest_field" = "Meta_MfgPlantCode"
      },
      {
        "src_field" = "Data"
        "path" = "$.Meta.Factory"
        "dest_field" = "Meta_Factory"
      },
      {
        "src_field" = "Data"
        "path" = "$.Meta.MessageName"
        "dest_field" = "Meta_MessageName"
      },
      {
        "src_field" = "Data"
        "path" = "$.Meta.Source"
        "dest_field" = "Meta_Source"
      },
      {
        "src_field" = "Data"
        "path" = "$.RawData.MessageName"
        "dest_field" = "RawData_MessageName"
      },
      {
        "src_field" = "Data"
        "path" = "$.RawData.Version"
        "dest_field" = "RawData_Version"
      },
      {
        "src_field" = "Data"
        "path" = "$.RawData.TimeStamp"
        "dest_field" = "RawData_TimeStamp"
      },
      {
        "src_field" = "Data"
        "path" = "$.RawData.UniqueID"
        "dest_field" = "RawData_UniqueID"
      },
      {
        "src_field" = "Data"
        "path" = "$.RawData.Source"
        "dest_field" = "RawData_Source"
      },
      {
        "src_field" = "Data"
        "path" = "$.RawData.Target"
        "dest_field" = "RawData_Target"
      },
      {
        "src_field" = "Data"
        "path" = "$.RawData.RequestID"
        "dest_field" = "RawData_RequestID"
      },
      {
        "src_field" = "Data"
        "path" = "$.RawData.MessageBody.$type"
        "dest_field" = "RawData_MessageBody_type"
      },
      {
        "src_field" = "Data"
        "path" = "$.RawData.MessageBody.TransactionID"
        "dest_field" = "RawData_MessageBody_TransactionID"
      },
      {
        "src_field" = "Data"
        "path" = "$.RawData.MessageBody.Result"
        "dest_field" = "RawData_MessageBody_Result"
      },
      {
        "src_field" = "Data"
        "path" = "$.RawData.MessageBody.PrimaryIdentifier"
        "dest_field" = "RawData_MessageBody_PrimaryIdentifier"
      },
      {
        "src_field" = "Data"
        "path" = "$.RawData.MessageBody.HermesIdentifier"
        "dest_field" = "RawData_MessageBody_HermesIdentifier"
      },
      {
        "src_field" = "Data"
        "path" = "$.RawData.MessageBody.UnitCount"
        "dest_field" = "RawData_MessageBody_UnitCount"
      }
    ]
  }
  
  Sql {
    source_table_name = "trans_json"
    result_table_name = "trans_msg_sql"   # Add this line to store the SQL processed data
    query = """
    select
        RawData_UniqueID,
        RawData_RequestID,
        ProcessedTime,
        RawData_MessageName,
        RawData_Version,
        RawData_TimeStamp,
        RawData_Source,
        RawData_Target,
        RawData_MessageBody_type,
        RawData_MessageBody_TransactionID,  -- renamed to avoid keyword conflict
        RawData_MessageBody_Result,
        RawData_MessageBody_PrimaryIdentifier,
        RawData_MessageBody_HermesIdentifier,
        RawData_MessageBody_UnitCount,
        Meta_DeviceID,
        Meta_LineID,
        Meta_MfgPlantCode,
        Meta_Factory,
        Meta_MessageName,
        Meta_Source,  -- renamed to avoid keyword conflict
        MessageID,
        MessageType,
        MessageVersion,
        MessageTime,
        Sender
      from trans_json
    """
  }
}

sink {
  Doris {
    source_table_name = "trans_msg_sql"
    result_table_name = "sink_doris"   # Add this line to store the final results
    doris.batch.size = 1024
    fenodes = "<doris-fe-host>:8030"
    username = "root"
    password = ""
    database = "test_variant"  #"dataplatform"
    table = "testaitkafka_ods_eap_workcomplete"
    sink.label-prefix = "testaitkafka"
    sink.enable-delete = "true"
    schema_save_mode = "CREATE_SCHEMA_WHEN_NOT_EXIST"
    data_save_mode = "APPEND_DATA"
    save_mode_create_template = """
    CREATE TABLE IF NOT EXISTS `test_variant`.`testaitkafka_ods_eap_workcomplete` (
        RawData_UniqueID VARCHAR(255) NULL,
        RawData_RequestID VARCHAR(255) NULL,
        ProcessedTime DATETIME NULL,
        RawData_MessageName VARCHAR(255) NULL,
        RawData_Version VARCHAR(255) NOT NULL,
        RawData_TimeStamp DATETIMEDATETIME NULL,
        RawData_Source VARCHAR(255) NULL,
        RawData_Target VARCHAR(255) NULL,
        RawData_MessageBody_type VARCHAR(255) NULL,
        RawData_MessageBody_TransactionID VARCHAR(255) NULL,  -- renamed to avoid keyword conflict
        RawData_MessageBody_Result VARCHAR(255) NULL,
        RawData_MessageBody_PrimaryIdentifier VARCHAR(255) NULL,
        RawData_MessageBody_HermesIdentifier VARCHAR(255) NULL,
        RawData_MessageBody_UnitCount VARCHAR(255) NULL,
        Meta_DeviceID VARCHAR(255) NULL,
        Meta_LineID VARCHAR(255) NULL,
        Meta_MfgPlantCode VARCHAR(255) NULL,
        Meta_Factory VARCHAR(255) NULL,
        Meta_MessageName VARCHAR(255) NULL,
        Meta_Source VARCHAR(255) NULL,  -- renamed to avoid keyword conflict
        MessageID VARCHAR(255) NULL,
        MessageType VARCHAR(255) NULL,
        MessageVersion VARCHAR(255) NULL,
        MessageTime DATETIME NULL,
        Sender VARCHAR(255) NULL
    ) ENGINE=OLAP
    UNIQUE KEY(`RawData_UniqueID`, `RawData_RequestID`, `ProcessedTime`)
    DISTRIBUTED BY HASH(`RawData_UniqueID`) BUCKETS AUTO
    """
    doris.config {
      format = "json"
      read_json_by_line = "true"
    }
  }
}

